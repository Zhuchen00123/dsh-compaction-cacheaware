{
  "name": "dsh-compaction-cacheaware",
  "version": "0.2.0",
  "description": "Reasonix-style cache-aware compaction backend for DeepSeek Harness (DSH). Replaces/enhances compaction-basic with compact_ratio, one structured summary checkpoint, and a stable recent tail.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zhuchen00123/dsh-compaction-cacheaware.git"
  },
  "homepage": "https://github.com/Zhuchen00123/dsh-compaction-cacheaware#readme",
  "bugs": {
    "url": "https://github.com/Zhuchen00123/dsh-compaction-cacheaware/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "compaction",
    "reasonix",
    "cache-aware",
    "plugin"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "README.md",
    "docs/MIGRATION_0.1.11_TO_0.2.0.md",
    "docs/DESKTOP_MIGRATION.md",
    "LICENSE",
    "cordis.patch.yml",
    "cordis.patch.example.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/config.test.mjs tests/selection.test.mjs tests/engine.integration.test.mjs",
    "prepack": "npm run typecheck && npm run build",
    "sync:reasonix": "node scripts/sync-reasonix-compact.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-agent": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-compaction-tool-result-pruner": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-commands": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction": "0.2.0-rc.2",
    "@deepseek-ai/dsh-compaction-tool-result-pruner": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "22.10.0",
    "typescript": "5.7.2"
  }
}
